{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "agent",
    "workflow",
    "verification",
    "policies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goals",
        "context"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "autonomy"
      ],
      "properties": {
        "provider": {
          "enum": [
            "copilot",
            "junie",
            "both",
            "none"
          ]
        },
        "autonomy": {
          "enum": [
            "conservative",
            "balanced",
            "advanced"
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRepairAttempts"
      ],
      "properties": {
        "maxRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "cwd",
          "timeout"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeout": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3600000
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "protected",
        "constraints"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
